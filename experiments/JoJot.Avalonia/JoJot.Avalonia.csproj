<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <InternalsVisibleTo Include="JoJot.Avalonia.Tests" />
    <AvaloniaResource Include="../../JoJot/Assets/jojot.ico" Link="Assets/jojot.ico" />
    <ProjectReference Include="../JoJot.Storage/JoJot.Storage.csproj" />
  </ItemGroup>
  <!-- Use the release version maintained in the WPF project by the release workflow. -->
  <Target Name="ReadJoJotReleaseVersion" BeforeTargets="GetAssemblyVersion">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../JoJot/JoJot.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="JoJotReleaseVersion" />
    </XmlPeek>
    <Error Condition="'$(JoJotReleaseVersion)' == ''" Text="The JoJot release version is missing." />
    <PropertyGroup>
      <Version>$(JoJotReleaseVersion)</Version>
    </PropertyGroup>
  </Target>
  <!-- .NET 11 does not classify project-reference satellites as resource assets for ILC. -->
  <Target Name="IncludeJoJotStorageSatelliteForNativeAot"
          AfterTargets="_ComputeIlcCompileInputs" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <IlcSatelliteAssembly Include="@(ResolvedFileToPublish)"
                            Condition="'%(ResolvedFileToPublish.Filename)' == 'JoJot.Storage.resources' and '%(ResolvedFileToPublish.AssetType)' != 'resources'" />
    </ItemGroup>
  </Target>
</Project>
