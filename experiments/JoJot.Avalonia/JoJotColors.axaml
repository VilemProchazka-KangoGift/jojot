<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
    <SolidColorBrush x:Key="c-on-accent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="c-win-bg" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="c-sidebar-bg" Color="#EEF1F4"/>
    <SolidColorBrush x:Key="c-editor-bg" Color="#FFFEFA"/>
    <SolidColorBrush x:Key="c-border" Color="#DCE2E7"/>
    <SolidColorBrush x:Key="c-text-primary" Color="#22313B"/>
    <SolidColorBrush x:Key="c-text-muted" Color="#627480"/>
    <SolidColorBrush x:Key="c-accent" Color="#087F78"/>
    <SolidColorBrush x:Key="c-hover-bg" Color="#E2E9EC"/>
    <SolidColorBrush x:Key="c-selected-bg" Color="#D6EBE7"/>
    <SolidColorBrush x:Key="c-toolbar-icon" Color="#526873"/>
    <SolidColorBrush x:Key="c-toolbar-icon-hover" Color="#263B47"/>
    <SolidColorBrush x:Key="c-tab-bg" Color="#E8EDF0"/>
    <SolidColorBrush x:Key="c-toast-bg" Color="#263B47"/>
    <SolidColorBrush x:Key="c-toast-fg" Color="#FFFEFA"/>
    <SolidColorBrush x:Key="c-overlay-bg" Color="#80000000"/>
    <SolidColorBrush x:Key="c-tooltip-bg" Color="#CC333333"/>
    <SolidColorBrush x:Key="c-danger" Color="#C8484B"/>
    <SolidColorBrush x:Key="c-find-match-bg" Color="#50FFDD00"/>
    <SolidColorBrush x:Key="c-find-match-active-bg" Color="#70FF8C00"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
    <SolidColorBrush x:Key="c-on-accent" Color="#142028" />
    <SolidColorBrush x:Key="c-win-bg" Color="#19242C"/>
    <SolidColorBrush x:Key="c-sidebar-bg" Color="#142028"/>
    <SolidColorBrush x:Key="c-editor-bg" Color="#19242C"/>
    <SolidColorBrush x:Key="c-border" Color="#344650"/>
    <SolidColorBrush x:Key="c-text-primary" Color="#E4EBED"/>
    <SolidColorBrush x:Key="c-text-muted" Color="#A2B3BC"/>
    <SolidColorBrush x:Key="c-accent" Color="#65C8BA"/>
    <SolidColorBrush x:Key="c-hover-bg" Color="#263943"/>
    <SolidColorBrush x:Key="c-selected-bg" Color="#214842"/>
    <SolidColorBrush x:Key="c-toolbar-icon" Color="#AEC0C9"/>
    <SolidColorBrush x:Key="c-toolbar-icon-hover" Color="#FFFEFA"/>
    <SolidColorBrush x:Key="c-tab-bg" Color="#263B47"/>
    <SolidColorBrush x:Key="c-toast-bg" Color="#344650"/>
    <SolidColorBrush x:Key="c-toast-fg" Color="#E4EBED"/>
    <SolidColorBrush x:Key="c-overlay-bg" Color="#80000000"/>
    <SolidColorBrush x:Key="c-tooltip-bg" Color="#CC333333"/>
    <SolidColorBrush x:Key="c-danger" Color="#E58C8C"/>
    <SolidColorBrush x:Key="c-find-match-bg" Color="#50CCCC00"/>
    <SolidColorBrush x:Key="c-find-match-active-bg" Color="#70FF9632"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
