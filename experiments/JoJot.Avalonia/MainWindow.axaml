<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:JoJot.Models"
        xmlns:res="using:JoJot.Resources"
        x:Class="JoJot.AvaloniaExperiment.MainWindow"
        x:CompileBindings="True"
        Title="JoJot · Avalonia experiment"
        MinWidth="510" MinHeight="360">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="10,7" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Button x:Name="AddButton" Click="OnAdd" Classes="accent" IsEnabled="False"
                Content="{x:Static res:Strings.Date_NewNote}" />
        <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="240" HorizontalAlignment="Stretch"
                 PlaceholderText="Search notes" AutomationProperties.Name="Search notes" TextChanged="OnSearchChanged" />
        <Button x:Name="HamburgerButton" Grid.Column="2" Content="☰" AutomationProperties.Name="Menu">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem x:Name="OpenFilesMenuItem" Header="Open files…" Click="OnOpenFiles" />
              <MenuItem x:Name="PreferencesMenuItem" Header="Preferences" Click="OnPreferencesMenu" />
              <MenuItem x:Name="HelpMenuItem" Header="Help" Click="OnHelpMenu" />
              <MenuItem x:Name="CleanupMenuItem" Header="Cleanup" Click="OnCleanupMenu" />
              <MenuItem x:Name="RecoveryMenuItem" Header="Recover notes" Click="OnRecoveryMenu" />
              <Separator />
              <MenuItem x:Name="ExitMenuItem" Header="Exit" Click="OnExitMenu" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid x:Name="WorkArea" IsEnabled="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190" MinWidth="120" MaxWidth="400" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" MinWidth="210" />
        </Grid.ColumnDefinitions>
        <Border Padding="4">
          <ListBox x:Name="NoteList" SelectionChanged="OnNoteSelected" AutomationProperties.Name="Notes">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:NoteTab">
                <Grid RowDefinitions="Auto,Auto">
                  <Border Height="1" Margin="0,0,0,4" IsVisible="{Binding ShowUnpinnedSeparator}"
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="5">
                    <TextBlock Text="●" IsVisible="{Binding Pinned}" VerticalAlignment="Center" FontSize="9"
                               AutomationProperties.Name="Pinned" />
                    <TextBlock Grid.Column="1" Text="▤" IsVisible="{Binding IsFileBacked}"
                               AutomationProperties.Name="File-backed note" />
                    <StackPanel Grid.Column="2" MinWidth="0">
                      <TextBlock x:Name="TabLabel" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis"
                                 Classes.placeholder="{Binding IsPlaceholder}" />
                      <TextBlock Text="{Binding UpdatedDisplay}" FontSize="10" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding UpdatedTooltipText}"
                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0">
                      <Button Classes="tabAction" Content="📌" ToolTip.Tip="{x:Static res:Strings.Tooltip_PinShort}" Click="OnRowPin" />
                      <Button Classes="tabAction" Content="×" ToolTip.Tip="{x:Static res:Strings.Tooltip_Delete}" Click="OnRowClose" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <GridSplitter x:Name="TabSplitter" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*" Margin="9,6,9,7" RowSpacing="5">
          <TextBlock x:Name="NoteTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <WrapPanel Grid.Row="1">
            <Button x:Name="UndoButton" Classes="toolbar" Content="&#xE7A7;" ToolTip.Tip="Undo" AutomationProperties.Name="Undo" Click="OnUndo" />
            <Button x:Name="RedoButton" Classes="toolbar" Content="&#xE7A6;" ToolTip.Tip="Redo" AutomationProperties.Name="Redo" Click="OnRedo" />
            <Button x:Name="RenameButton" Classes="toolbar" Content="&#xE8AC;" Click="OnRename" />
            <Button x:Name="PinButton" Classes="toolbar" Content="&#xE718;" Click="OnPin" />
            <Button x:Name="CloneButton" Classes="toolbar" Content="&#xF413;" Click="OnClone" />
            <Button x:Name="CopyButton" Classes="toolbar" Content="&#xE8C8;" Click="OnCopy" />
            <Button x:Name="PasteButton" Classes="toolbar" Content="&#xE77F;" Click="OnPaste" />
            <Button x:Name="SaveButton" Classes="toolbar" Content="&#xE74E;" Click="OnSave" />
            <Button x:Name="SaveAsButton" Classes="toolbar" Content="&#xE792;" Click="OnSaveAs" />
            <Button x:Name="FindButton" Classes="toolbar" Content="&#xE721;" Click="OnFind" />
            <Button x:Name="DeleteButton" Classes="toolbar" Content="&#xE74D;" Click="OnDelete" />
          </WrapPanel>
          <Border x:Name="FindHost" Grid.Row="2" IsVisible="False" />
          <TextBox x:Name="Editor" Grid.Row="3" FontSize="13" AcceptsReturn="True" AcceptsTab="True"
                   IsUndoEnabled="False" IsInactiveSelectionHighlightEnabled="True" ClearSelectionOnLostFocus="False" TextWrapping="Wrap" VerticalContentAlignment="Top"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnEditorChanged"
                   AutomationProperties.Name="Note editor" />
        </Grid>
      </Grid>
      <Border x:Name="FileDropHost" IsVisible="False" IsHitTestVisible="False"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Opacity="0.94" Padding="12">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
          <TextBlock x:Name="DropHeading" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
          <TextBlock x:Name="DropHint" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border x:Name="PanelHost" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1,0,0,0" />
    </Grid>
    <StackPanel Grid.Row="2">
      <Border x:Name="ToastHost" IsVisible="False" Padding="10,4"
              Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
          <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button x:Name="UndoToastButton" Grid.Column="1" Content="Undo" Click="OnUndoToast" />
          <Button Grid.Column="2" Content="×" AutomationProperties.Name="Dismiss notification" Click="OnDismissToast" />
        </Grid>
      </Border>
      <TextBlock x:Name="Status" Padding="10,4" Text="Opening notes…"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
  <Window.Styles>
    <Style Selector="Button.toolbar">
      <Setter Property="Padding" Value="5,4" />
      <Setter Property="Margin" Value="0,0,2,2" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    </Style>
    <Style Selector="Button.tabAction">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.tabAction">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem.dropAbove">
      <Setter Property="BorderThickness" Value="0,2,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="ListBoxItem.dropBelow">
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="TextBlock.placeholder">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
  </Window.Styles>
</Window>
