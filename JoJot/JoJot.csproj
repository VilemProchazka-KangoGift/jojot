<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>JoJot.Program</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Ship only the app's own UI languages: EF Core otherwise drops 13 satellite folders. -->
    <SatelliteResourceLanguages>en;cs</SatelliteResourceLanguages>
    <!-- Small heap: no background GC thread to spin up at startup. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Default since .NET 8; explicit so it is not lost to a future property change. -->
    <TieredPGO>true</TieredPGO>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Version metadata (CalVer) -->
    <Version>2026.10.3</Version>
    <AssemblyVersion>2026.10.3.0</AssemblyVersion>
    <FileVersion>2026.10.3.0</FileVersion>

    <!-- Publisher and product info -->
    <Company>Vilem Prochazka</Company>
    <Authors>Vilem Prochazka</Authors>
    <Product>JoJot</Product>
    <Description>Per-virtual-desktop notepad for Windows</Description>
    <Copyright>Copyright 2026 Vilem Prochazka</Copyright>

    <!-- Application icon -->
    <ApplicationIcon>Assets\jojot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoJot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\jojot.ico" />
  </ItemGroup>

  <!-- Localization: generate typed accessor from Strings.resx -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Override the transitive SQLitePCLRaw pulled in by EF Core 10.0.3 (2.1.11, vulnerable per
         GHSA-2m69-gcr7-jv3q) with the patched 3.x line. The raw/bundle API is source-compatible. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
